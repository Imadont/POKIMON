            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#has_Output"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
