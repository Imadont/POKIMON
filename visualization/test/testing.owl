    </owl:Class>
    


    <!-- http://www.POKIMON#Disposition -->

    <owl:Class rdf:about="http://www.POKIMON#Disposition">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Realizable_Entity"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Disposition_To_Be_Deleted -->

    <owl:Class rdf:about="http://www.POKIMON#Disposition_To_Be_Deleted">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Disposition"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Disposition_To_Be_Enriched -->

    <owl:Class rdf:about="http://www.POKIMON#Disposition_To_Be_Enriched">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Disposition"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Disposition_To_Be_Modified -->

    <owl:Class rdf:about="http://www.POKIMON#Disposition_To_Be_Modified">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Disposition"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Drawing -->

    <owl:Class rdf:about="http://www.POKIMON#Drawing">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Image"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Erosive_Contact -->

    <owl:Class rdf:about="http://www.POKIMON#Erosive_Contact">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Contact"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Ersatz_Spatial_Location -->

    <owl:Class rdf:about="http://www.POKIMON#Ersatz_Spatial_Location">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Spatial_Location"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Ersatz_Temporal_Location -->

    <owl:Class rdf:about="http://www.POKIMON#Ersatz_Temporal_Location">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Temporal_Location"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Estimation_Process -->

    <owl:Class rdf:about="http://www.POKIMON#Estimation_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Planned_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Evaluation -->

    <owl:Class rdf:about="http://www.POKIMON#Evaluation">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Non_Physical_Temporal_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Evaluation_Algorithm -->

    <owl:Class rdf:about="http://www.POKIMON#Evaluation_Algorithm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Algorithm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Evaluation_Process -->

    <owl:Class rdf:about="http://www.POKIMON#Evaluation_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Planned_Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#has_Output"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#Evaluation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


