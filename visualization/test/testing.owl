                <owl:onProperty rdf:resource="http://www.POKIMON#is_Output_Of"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#Evaluation_Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A specific situation where some entities are not inconsistent according to a rule, law or any entity that governs these entities</rdfs:comment>
    </owl:Class>
    


