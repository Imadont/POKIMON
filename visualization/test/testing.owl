<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.POKIMON#"
     xml:base="http://www.POKIMON"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.POKIMON"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.POKIMON#Criteria_For_Selection -->

    <owl:AnnotationProperty rdf:about="http://www.POKIMON#Criteria_For_Selection">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#anySimpleType -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#anySimpleType"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.POKIMON#Interprets -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#Interprets">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_About"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#alters_For_Representation -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#alters_For_Representation"/>
    


    <!-- http://www.POKIMON#bearer_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#bearer_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#has_Specific_Dependant"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#inheres_In"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#concretizes -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#concretizes">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Specifically_Dependant_On"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Concretized_By"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#IQE"/>
        <rdfs:range rdf:resource="http://www.POKIMON#Information_Content_Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#contradicts -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#contradicts">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Specifically_Dependant_On"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#describes -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#describes"/>
    


    <!-- http://www.POKIMON#designates -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#designates">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_About"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#details -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#details">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Detailed_By"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#explains -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#explains">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_About"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Explained_By"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#governs -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#governs">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_About"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Governed_By"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#Information_Entity"/>
        <rdfs:comment>reality is governed by laws</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Action_Specification -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Action_Specification"/>
    


    <!-- http://www.POKIMON#has_Anomalic_Part -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Anomalic_Part">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#has_Part"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Anomalic_Part_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Dimension -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Dimension">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#has_Quality"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#Spatial_Space"/>
        <rdfs:range rdf:resource="http://www.POKIMON#Spatial_Dimension"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Disposition_To -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Disposition_To"/>
    


    <!-- http://www.POKIMON#has_Disposition_To_Be_Represented_In -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Disposition_To_Be_Represented_In">
        <rdfs:range rdf:resource="http://www.POKIMON#Reference_Space"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Evaluation -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Evaluation">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#has_Quality"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Evaluation_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Generic_Dependant -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Generic_Dependant">
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Generically_Dependant_On"/>
        <rdfs:range rdf:resource="http://www.POKIMON#Generically_Dependent_Continuant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Input -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Input">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#has_Participant"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Input_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Objective_Specification -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Objective_Specification">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#has_Generic_Dependant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Origin -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Origin">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#has_Quality"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Output -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Output">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#has_Participant"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Output_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Overlying_rock_Body -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Overlying_rock_Body"/>
    


    <!-- http://www.POKIMON#has_Part -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Part">
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Part_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Participant -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Participant">
        <owl:inverseOf rdf:resource="http://www.POKIMON#participates_In"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#Process"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Quality -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Quality">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#bearer_Of"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Quality_Of"/>
        <rdfs:range rdf:resource="http://www.POKIMON#Quality"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Semantic_Component -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Semantic_Component">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#provides_Semantic_Component_For"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Shape -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Shape"/>
    


    <!-- http://www.POKIMON#has_Specific_Dependant -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Specific_Dependant">
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Specifically_Dependant_On"/>
        <rdfs:range rdf:resource="http://www.POKIMON#Specifically_Dependent_Continuant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Structural_Part -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Structural_Part">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#has_Part"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Structural_Part_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#has_Underlying_rock_Body -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Underlying_rock_Body"/>
    


    <!-- http://www.POKIMON#hosts -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#hosts">
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Hosted_By"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#inheres_In -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#inheres_In">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Specifically_Dependant_On"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#Quality"/>
                    <rdf:Description rdf:about="http://www.POKIMON#Realizable_Entity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_About -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_About">
        <owl:inverseOf rdf:resource="http://www.POKIMON#is_Subject_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Anomalic_Part_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Anomalic_Part_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Part_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Concretized_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Concretized_By">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#has_Specific_Dependant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Detailed_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Detailed_By">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Subject_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Dissatisfied_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Dissatisfied_By">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#has_Specific_Dependant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Evaluation_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Evaluation_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#inheres_In"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Explained_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Explained_By">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Subject_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Generically_Dependant_On -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Generically_Dependant_On">
        <rdfs:domain rdf:resource="http://www.POKIMON#Generically_Dependent_Continuant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Governed_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Governed_By">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Subject_Of"/>
        <rdfs:range rdf:resource="http://www.POKIMON#Information_Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Hosted_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Hosted_By"/>
    


    <!-- http://www.POKIMON#is_Input_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Input_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#participates_In"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Origin_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Origin_Of">
        <rdfs:domain rdf:resource="http://www.POKIMON#Origin"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Output_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Output_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#participates_In"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Part_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Part_Of"/>
    


    <!-- http://www.POKIMON#is_Prescribed_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Prescribed_By">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Subject_Of"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#prescribes"/>
        <rdfs:range rdf:resource="http://www.POKIMON#Plan_Specification"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Quality_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Quality_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#inheres_In"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#Quality"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Representation_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Representation_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Concretized_By"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#represents"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Satisfied_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Satisfied_By">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#satisfies"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Simplified_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Simplified_By">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Subject_Of"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#simplifies"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Specifically_Dependant_On -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Specifically_Dependant_On">
        <rdfs:domain rdf:resource="http://www.POKIMON#Specifically_Dependent_Continuant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Structural_Part_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Structural_Part_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Part_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#is_Subject_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#is_Subject_Of"/>
    


    <!-- http://www.POKIMON#participates_In -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#participates_In">
        <rdfs:range rdf:resource="http://www.POKIMON#Process"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#plays_Role -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#plays_Role"/>
    


    <!-- http://www.POKIMON#prescribes -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#prescribes">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_About"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#provides_Depiction_Component_For -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#provides_Depiction_Component_For">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Part_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#provides_Semantic_Component_For -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#provides_Semantic_Component_For">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#is_Part_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#realizes -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#realizes">
        <rdfs:domain rdf:resource="http://www.POKIMON#Process"/>
        <rdfs:range rdf:resource="http://www.POKIMON#Disposition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#represents -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#represents">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#concretizes"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#Represented_Model"/>
        <rdfs:range rdf:resource="http://www.POKIMON#Model"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#satisfies -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#satisfies">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>a model sastisfies an information entity</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#simplifies -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#simplifies">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#Model"/>
        <rdfs:range rdf:resource="http://www.POKIMON#Model"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#substitutes -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#substitutes">
        <rdfs:domain rdf:resource="http://www.POKIMON#Geomodel"/>
        <rdfs:range rdf:resource="http://www.POKIMON#Geomodel"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.POKIMON#has_Time_Stamp -->

    <owl:DatatypeProperty rdf:about="http://www.POKIMON#has_Time_Stamp">
        <rdfs:domain rdf:resource="http://www.POKIMON#Quality"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.POKIMON#has_Unit_Of_Measure -->

    <owl:DatatypeProperty rdf:about="http://www.POKIMON#has_Unit_Of_Measure">
        <rdfs:domain rdf:resource="http://www.POKIMON#Quality"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.POKIMON#has_Value -->

    <owl:DatatypeProperty rdf:about="http://www.POKIMON#has_Value">
        <rdfs:domain rdf:resource="http://www.POKIMON#Quality"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.POKIMON#Action_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#Action_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Information_Content_Entity"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Adding_Entity_Algorithm -->

    <owl:Class rdf:about="http://www.POKIMON#Adding_Entity_Algorithm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Algorithm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Adding_Entity_Process -->

    <owl:Class rdf:about="http://www.POKIMON#Adding_Entity_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Planned_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Agent -->

    <owl:Class rdf:about="http://www.POKIMON#Agent">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Independent_Continuant"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Algorithm -->

    <owl:Class rdf:about="http://www.POKIMON#Algorithm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Plan_Specification"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Amplitude -->

    <owl:Class rdf:about="http://www.POKIMON#Amplitude">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Analysis -->

    <owl:Class rdf:about="http://www.POKIMON#Analysis">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Proposition_Content_Entity"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Anticline -->

    <owl:Class rdf:about="http://www.POKIMON#Anticline">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Fold"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Antiform -->

    <owl:Class rdf:about="http://www.POKIMON#Antiform">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Fold"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Assumed_Origin -->

    <owl:Class rdf:about="http://www.POKIMON#Assumed_Origin">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Origin"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Breccia -->

    <owl:Class rdf:about="http://www.POKIMON#Breccia">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Rock_Material"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Certainty -->

    <owl:Class rdf:about="http://www.POKIMON#Certainty">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Non_Physical_Temporal_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Complex_Modify -->

    <owl:Class rdf:about="http://www.POKIMON#Complex_Modify">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Modifying_Entity_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Conceptual_Geological_Model -->

    <owl:Class rdf:about="http://www.POKIMON#Conceptual_Geological_Model">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Geomodel"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#has_Quality"/>
                        <owl:allValuesFrom rdf:resource="http://www.POKIMON#Original_Spatial_Location"/>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#substitutes"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#Conceptual_Geological_Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>a model missing its exact spatial locations (could have the global geometry without the location of its parts)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#Conformable_Contact -->

    <owl:Class rdf:about="http://www.POKIMON#Conformable_Contact">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Contact"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Connectionist_Content_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#Connectionist_Content_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Depiction_Content_Entity"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Constraint -->

    <owl:Class rdf:about="http://www.POKIMON#Constraint">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Information_Entity"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Contact -->

    <owl:Class rdf:about="http://www.POKIMON#Contact">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Specifically_Dependent_Geological_Structure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Context -->

    <owl:Class rdf:about="http://www.POKIMON#Context">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Situation"/>
        <rdfs:comment>Context class is serving a similar purpose to setting in GSO, and provides a context for some specific things (any owl:thing)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#Continuant -->

    <owl:Class rdf:about="http://www.POKIMON#Continuant"/>
    


    <!-- http://www.POKIMON#Continuant_Aggregate -->

    <owl:Class rdf:about="http://www.POKIMON#Continuant_Aggregate">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Continuant"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Criterium -->

    <owl:Class rdf:about="http://www.POKIMON#Criterium">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Information_Entity"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Criterium_Unit_Distinction -->

    <owl:Class rdf:about="http://www.POKIMON#Criterium_Unit_Distinction">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Criterium"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Cross_Section -->

    <owl:Class rdf:about="http://www.POKIMON#Cross_Section">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Transect"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Decision -->

    <owl:Class rdf:about="http://www.POKIMON#Decision">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Realizable_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#is_Output_Of"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#Decision_Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#is_Specifically_Dependant_On"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#Decision_Algorithm -->

    <owl:Class rdf:about="http://www.POKIMON#Decision_Algorithm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Algorithm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Decision_Process -->

    <owl:Class rdf:about="http://www.POKIMON#Decision_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Planned_Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#has_Input"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#Geomodel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#Deleting_Entity_Algorithm -->

    <owl:Class rdf:about="http://www.POKIMON#Deleting_Entity_Algorithm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Algorithm"/>
