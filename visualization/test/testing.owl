    <!-- http://www.POKIMON#Deterministic_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#Deterministic_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Action_Specification"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Dip -->

    <owl:Class rdf:about="http://www.POKIMON#Dip">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Displacement -->

    <owl:Class rdf:about="http://www.POKIMON#Displacement">
