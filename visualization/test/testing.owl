    <!-- http://www.POKIMON#Model -->

    <owl:Class rdf:about="http://www.POKIMON#Model">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#Information_Content_Entity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#has_Part"/>
                        <owl:someValuesFrom rdf:resource="http://www.POKIMON#Semantic_Content_Entity"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#satisfies"/>
                        <owl:someValuesFrom rdf:resource="http://www.POKIMON#Information_Entity"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#has_Part"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.POKIMON#Depiction_Content_Entity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Information_Content_Entity"/>
    </owl:Class>
    


