    <owl:Class rdf:about="http://www.POKIMON#Excplicit_Modeling">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#3D_Structural_Modeling"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Fault -->

    <owl:Class rdf:about="http://www.POKIMON#Fault">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Specifically_Dependent_Geological_Structure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Fault_Core_Zone -->

    <owl:Class rdf:about="http://www.POKIMON#Fault_Core_Zone">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Spatial_Region"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Feature_Space -->

    <owl:Class rdf:about="http://www.POKIMON#Feature_Space">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Reference_Space"/>
        <owl:disjointWith rdf:resource="http://www.POKIMON#Spatial_Space"/>
        <owl:disjointWith rdf:resource="http://www.POKIMON#Spatio_Temporal_Space"/>
        <owl:disjointWith rdf:resource="http://www.POKIMON#Temporal_Space"/>
        <rdfs:comment>any feature space except of spatial and temporal spaces</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#Figurative_Content_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#Figurative_Content_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Depiction_Content_Entity"/>
        <rdfs:comment>any type of figure</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#Fold -->

    <owl:Class rdf:about="http://www.POKIMON#Fold">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Specifically_Dependent_Geological_Structure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#has_Part"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#Shape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#has_Structural_Part"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.POKIMON#Fold_Hinge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#has_Structural_Part"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.POKIMON#Fold_Limb"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#Fold_Hinge -->

    <owl:Class rdf:about="http://www.POKIMON#Fold_Hinge">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Specifically_Dependent_Geological_Structure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Fold_Limb -->

    <owl:Class rdf:about="http://www.POKIMON#Fold_Limb">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Specifically_Dependent_Geological_Structure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Generically_Dependent_Continuant -->

    <owl:Class rdf:about="http://www.POKIMON#Generically_Dependent_Continuant">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#Continuant"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#is_Generically_Dependant_On"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.POKIMON#Generically_Dependent_Geological_Structure -->

    <owl:Class rdf:about="http://www.POKIMON#Generically_Dependent_Geological_Structure">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Generically_Dependent_Continuant"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Geological_Law -->

    <owl:Class rdf:about="http://www.POKIMON#Geological_Law">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Norm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Geological_Map_Legend -->

    <owl:Class rdf:about="http://www.POKIMON#Geological_Map_Legend">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Conceptual_Geological_Model"/>
        <rdfs:comment>The legend gives typically temporal and topological relations between objects without specifying shape and locations of the objects</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#Geological_Principle -->

    <owl:Class rdf:about="http://www.POKIMON#Geological_Principle">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Norm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Geological_Process -->

    <owl:Class rdf:about="http://www.POKIMON#Geological_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Natural_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Geological_Unit -->

    <owl:Class rdf:about="http://www.POKIMON#Geological_Unit">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Rock_Body"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Geometric_Volumetric_Figure -->

    <owl:Class rdf:about="http://www.POKIMON#Geometric_Volumetric_Figure">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Physical_Volumetric_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Geomodel -->

    <owl:Class rdf:about="http://www.POKIMON#Geomodel">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Model"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#Interprets"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#satisfies"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#Information_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#Geophysical_Surfacic_Figure -->

    <owl:Class rdf:about="http://www.POKIMON#Geophysical_Surfacic_Figure">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Physical_Surfacic_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Geophysical_Volumetric_Figure -->

    <owl:Class rdf:about="http://www.POKIMON#Geophysical_Volumetric_Figure">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Physical_Volumetric_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Hybrid -->

    <owl:Class rdf:about="http://www.POKIMON#Hybrid">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Technique"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Hybrid_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#Hybrid_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Action_Specification"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#IA -->

    <owl:Class rdf:about="http://www.POKIMON#IA">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Material_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#has_Generic_Dependant"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#Information_Content_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#has_Specific_Dependant"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#IQE"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#IQE -->

    <owl:Class rdf:about="http://www.POKIMON#IQE">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#Non_Physical_Temporal_Quality"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#concretizes"/>
                        <owl:someValuesFrom rdf:resource="http://www.POKIMON#Information_Content_Entity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Non_Physical_Temporal_Quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#is_About"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#is_Specifically_Dependant_On"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#IA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#is_Specifically_Dependant_On"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#Syntax"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#Image -->

    <owl:Class rdf:about="http://www.POKIMON#Image">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Physical_Surfacic_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Immaterial_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#Immaterial_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Independent_Continuant"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Implicit_Modeling -->

    <owl:Class rdf:about="http://www.POKIMON#Implicit_Modeling">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#3D_Structural_Modeling"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Independent_Continuant -->

    <owl:Class rdf:about="http://www.POKIMON#Independent_Continuant">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#Continuant"/>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.POKIMON#is_Generically_Dependant_On"/>
                                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.POKIMON#is_Specifically_Dependant_On"/>
                                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                                    </owl:Restriction>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:complementOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.POKIMON#Information_Content_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#Information_Content_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Generically_Dependent_Continuant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#is_About"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#is_Concretized_By"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#IQE"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#is_Generically_Dependant_On"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#IA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#has_Part"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#Information_Content_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.POKIMON#Information_Entity"/>
