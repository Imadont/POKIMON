    <!-- http://www.POKIMON#Deleting_Entity_Process -->

    <owl:Class rdf:about="http://www.POKIMON#Deleting_Entity_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Planned_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#Depiction_Content_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#Depiction_Content_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#Information_Content_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#has_Part"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#Depiction_Content_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>an information content entity based on the paradigms of representations</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#Description -->

    <owl:Class rdf:about="http://www.POKIMON#Description">
