<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.POKIMON#"
     xml:base="http://www.POKIMON"
     xmlns:POK="http://www.POKIMON#POK:"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:owlr="http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.POKIMON"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name -->

    <owl:AnnotationProperty rdf:about="http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#anySimpleType -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#anySimpleType"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.POKIMON#has_Depiction_Component -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#has_Depiction_Component">
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Depiction_Content_Entity"/>
        <rdfs:isDefinedBy>holds between a DCE and its representational components, e.g. size or scale.</rdfs:isDefinedBy>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:Interprets -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:Interprets">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_About"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:bearer_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:bearer_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:has_Specific_Dependant"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:inheres_In"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:concretizes -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:concretizes">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_Specifically_Dependant_On"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Concretized_By"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:IQE"/>
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Information_Content_Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:contradicts -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:contradicts">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Contradicted_By"/>
        <rdfs:isDefinedBy>indicate  whether an entity contravenes a governing entity. The intent is to specify whether entities in a model discconform to general knowledge (norms or constraints), or whether entities in distinct geomodels are disconformant because the general knowledge they satisfy is disconformant. This relations hold between: (1) geomodels; (2) geomodels or SCEs and a norm or constraint; (3) SCEs in different geomodels.</rdfs:isDefinedBy>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:details -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:details">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:substitutes"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:simplifies"/>
        <rdfs:isDefinedBy>a specialization of the substitutes relation for the cases in which the replacement model has increased (detailed) complexity, e.g. due to a change in geographical scale.</rdfs:isDefinedBy>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:explains -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:explains">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_About"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Explained_By"/>
        <rdfs:isDefinedBy>holds between a model and a situation, such that the model explains the situation by satisfying and not contradicting relevant norms, constraints, and conceptual models.</rdfs:isDefinedBy>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:governs -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:governs">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_About"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Governed_By"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Information_Entity"/>
        <rdfs:comment>reality is governed by laws</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Action_Specification -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Action_Specification"/>
    


    <!-- http://www.POKIMON#POK:has_Dimension -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Dimension">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:has_Quality"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Spatial_Space"/>
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Spatial_Dimension"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Disposition_To -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Disposition_To"/>
    


    <!-- http://www.POKIMON#POK:has_Evaluation -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Evaluation">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:has_Quality"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Evaluation_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Generic_Dependant -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Generic_Dependant">
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Generically_Dependant_On"/>
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Generically_Dependent_Continuant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Input -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Input">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:has_Participant"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Input_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Objective_Specification -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Objective_Specification">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:has_Generic_Dependant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Origin -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Origin">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:has_Quality"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Output -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Output">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:has_Participant"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Output_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Overlying_rock_Body -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Overlying_rock_Body"/>
    


    <!-- http://www.POKIMON#POK:has_Part -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Part">
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Part_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Participant -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Participant">
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:participates_In"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Process"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Quality -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Quality">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:bearer_Of"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Quality_Of"/>
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Quality"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Semantic_Component -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Semantic_Component">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:isDefinedBy>holds between an SCE and a geological l entity</rdfs:isDefinedBy>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Specific_Dependant -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Specific_Dependant">
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Specifically_Dependant_On"/>
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Specifically_Dependent_Continuant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:has_Underlying_rock_Body -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:has_Underlying_rock_Body"/>
    


    <!-- http://www.POKIMON#POK:hosts -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:hosts">
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Hosted_By"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:inheres_In -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:inheres_In">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_Specifically_Dependant_On"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Quality"/>
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Realizable_Entity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_About -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_About">
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:is_Subject_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Above -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Above"/>
    


    <!-- http://www.POKIMON#POK:is_Concretized_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Concretized_By">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:has_Specific_Dependant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Contradicted_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Contradicted_By">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Evaluation_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Evaluation_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_Quality_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Explained_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Explained_By">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_Subject_Of"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Generically_Dependant_On -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Generically_Dependant_On">
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Generically_Dependent_Continuant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Governed_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Governed_By">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_Subject_Of"/>
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Information_Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Hosted_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Hosted_By"/>
    


    <!-- http://www.POKIMON#POK:is_Input_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Input_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:participates_In"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Origin_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Origin_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_Quality_Of"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Origin"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Output_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Output_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:participates_In"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Part_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Part_Of"/>
    


    <!-- http://www.POKIMON#POK:is_Prescribed_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Prescribed_By">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_Subject_Of"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:prescribes"/>
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Plan_Specification"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Quality_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Quality_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:inheres_In"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Quality"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Representation_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Representation_Of">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:has_Specific_Dependant"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:represents"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Satisfied_By -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Satisfied_By">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.POKIMON#POK:satisfies"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Specifically_Dependant_On -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Specifically_Dependant_On">
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Specifically_Dependent_Continuant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:is_Subject_Of -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:is_Subject_Of"/>
    


    <!-- http://www.POKIMON#POK:participates_In -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:participates_In">
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Process"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:plays_Role -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:plays_Role"/>
    


    <!-- http://www.POKIMON#POK:prescribes -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:prescribes">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_About"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:realizes -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:realizes">
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Process"/>
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Disposition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:represents -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:represents">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:is_Specifically_Dependant_On"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Represented_Model"/>
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Model"/>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:satisfies -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:satisfies">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>Indicate  whether an entity conform to a governing entity. The intent is to specify whether entities in a model conform to general knowledge (norms or constraints), or whether entities in distinct geomodels are conformant because the general knowledge they satisfy is conformant. This relations hold between: (1) geomodels; (2) geomodels or SCEs and a norm or constraint; (3) SCEs in different geomodels.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:simplifies -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:simplifies">
        <rdfs:subPropertyOf rdf:resource="http://www.POKIMON#POK:substitutes"/>
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Model"/>
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Model"/>
        <rdfs:isDefinedBy>a specialization of the substitutes relation for the cases in which the replacement model has reduced (simplified) ) complexity, e.g. due to a change in geographical scale.</rdfs:isDefinedBy>
    </owl:ObjectProperty>
    


    <!-- http://www.POKIMON#POK:substitutes -->

    <owl:ObjectProperty rdf:about="http://www.POKIMON#POK:substitutes">
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Geomodel"/>
        <rdfs:range rdf:resource="http://www.POKIMON#POK:Geomodel"/>
        <rdfs:isDefinedBy>holds between models, to replace one with another, typically because the replacement satisfies more things and is deemed to be superior.  Models can only be substituted by the same kind of model, e.g. conceptual models by conceptual models and space-time models by space-time models.</rdfs:isDefinedBy>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.POKIMON#POK:has_Time_Stamp -->

    <owl:DatatypeProperty rdf:about="http://www.POKIMON#POK:has_Time_Stamp">
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Quality"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.POKIMON#POK:has_Unit_Of_Measure -->

    <owl:DatatypeProperty rdf:about="http://www.POKIMON#POK:has_Unit_Of_Measure">
        <rdfs:domain rdf:resource="http://www.POKIMON#POK:Quality"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.POKIMON#POK:has_Value -->

    <owl:DatatypeProperty rdf:about="http://www.POKIMON#POK:has_Value"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.POKIMON#POK:Action_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Action_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Information_Content_Entity"/>
        <rdfs:comment>IOF entity
original uri : https://spec.industrialontologies.org/ontology/core/Core/ActionSpecification</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Adding_Entity_Algorithm -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Adding_Entity_Algorithm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Algorithm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Adding_Entity_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Adding_Entity_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Age -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Age">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Temporal_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Agent -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Agent">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Independent_Continuant"/>
        <rdfs:isDefinedBy>An independent continuant that has the capacity to act, initiate processes, or bring about changes in reality through intentional or goal-directed activity. An agent may be a natural organism, an artificial system, or a collective entity, provided it has the capability to perform actions that influence other entities or states of affairs.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Algorithm -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Algorithm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Plan_Specification"/>
        <rdfs:isDefinedBy>a subtype of plan specficiations, one that is a finite, ordered set of unambiguous instructions for solving a problem or performing a computation that, when executed, produces a result and halts in a finite amount of time. Then, an algorithm prescribes a specific planned process by defining an action specification (the precise steps or computations) aimed at achieving an objective specification (the intended result).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Amplitude -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Amplitude">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Assumed_Origin -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Assumed_Origin">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Origin"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Breccia -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Breccia">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Rock_Material"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Certainty -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Certainty">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Non_Physical_Temporal_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Conceptual_Geological_Model -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Conceptual_Geological_Model">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Geomodel"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Quality"/>
                        <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Original_Spatial_Location"/>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:substitutes"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Conceptual_Geological_Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>a model missing its exact spatial locations (could have the global geometry without the location of its parts)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Connectionist_Content_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Connectionist_Content_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Depiction_Content_Entity"/>
        <rdfs:isDefinedBy>A depicion content entity whose representational form is realized through a connectionist pattern, such as the weight configurations of an artificial neural network or the synaptic connections and activation patterns in a biological neural system. The representational structure is typically of such complexity that humans cannot directly or intuitively interpret its content without specialized analytical methods or tools.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Constraint -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Constraint">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Information_Entity"/>
        <rdfs:isDefinedBy>An information entity that specifies a limitation or restriction on possible states, actions, or values.
Examples: “budget cannot exceed $10,000”; “temperature must remain between 2 °C and 8 °C during storage”.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Contact -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Contact">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Specifically_Dependent_Geological_Structure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Context -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Context">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Situation"/>
        <rdfs:comment>Context class is serving a similar purpose to setting in GSO, and provides a context for some specific things (any owl:thing)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Continuant -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Continuant">
        <rdfs:comment>SDC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000002</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Continuant_Aggregate -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Continuant_Aggregate">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Continuant"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Criterium -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Criterium">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Information_Entity"/>
        <rdfs:isDefinedBy>An information entity that specifies a standard, property, or condition used to judge, select, or classify something.
Examples: “must be over 18 years old to vote”; “p-value ≤ 0.05 is considered significant”.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Cross_Section -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Cross_Section">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Transect"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Decision -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Decision">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Information_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Output_Of"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Decision_Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>An information entity that results from a deliberative decision process, specifying a chosen course of action or selected option among alternatives.
Examples: “approve the merger”; “launch the product in Q3”, &quot;accept a geomodel&quot;.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Decision_Algorithm -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Decision_Algorithm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Algorithm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Decision_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Decision_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Input"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Geomodel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Output"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Decision"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Deleting_Entity_Algorithm -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Deleting_Entity_Algorithm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Algorithm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Deleting_Entity_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Deleting_Entity_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Depiction_Content_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Depiction_Content_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Information_Content_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Depiction_Content_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>an information content entity based on the paradigms of representations</rdfs:comment>
        <rdfs:isDefinedBy>An information content entity that embodies a specific representational paradigm used to convey the content of a semantic content of a model. A depiction content entity specifies how a given subject matter is represented, regardless of the particular domain. Examples include textual descriptions, pictorial depictions, geometric models, or connectionist patterns.
Scope: DCEs capture the representational form rather than the subject matter itself. The same underlying semantic content of a model may be realized in multiple depiction content entities using different modalities.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Deterministic -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Deterministic">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Technique"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Deterministic_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Deterministic_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Action_Specification"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Dip -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Dip">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Displacement -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Displacement">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Disposition -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Disposition">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Realizable_Entity"/>
        <rdfs:comment>SDC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000016</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Disposition_To_Be_Deleted -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Disposition_To_Be_Deleted">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Disposition"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Disposition_To_Be_Enriched -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Disposition_To_Be_Enriched">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Disposition"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Disposition_To_Be_Modified -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Disposition_To_Be_Modified">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Disposition"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Drawing -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Drawing">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Image"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Ersatz_Spatial_Location -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Ersatz_Spatial_Location">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Spatial_Location"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Ersatz_Temporal_Location -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Ersatz_Temporal_Location">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Temporal_Location"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Estimation_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Estimation_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Input"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Quality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Evaluation -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Evaluation">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Non_Physical_Temporal_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Evaluation_Algorithm -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Evaluation_Algorithm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Algorithm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Evaluation_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Evaluation_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Input"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Information_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Input"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Output"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Evaluation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Excplicit_Modeling -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Excplicit_Modeling">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:3D_Structural_Modeling"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Fault -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Fault">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Specifically_Dependent_Geological_Structure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Feature_Space -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Feature_Space">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Reference_Space"/>
        <owl:disjointWith rdf:resource="http://www.POKIMON#POK:Spatial_Space"/>
        <owl:disjointWith rdf:resource="http://www.POKIMON#POK:Spatio_Temporal_Space"/>
        <owl:disjointWith rdf:resource="http://www.POKIMON#POK:Temporal_Space"/>
        <rdfs:comment>any feature space except of spatial and temporal spaces</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Figurative_Content_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Figurative_Content_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Depiction_Content_Entity"/>
        <rdfs:comment>any type of figure</rdfs:comment>
        <rdfs:isDefinedBy>A depiction content entity whose representation is realized through a figure, either volumetric (e.g., a 3D geometric model using explicit or implicit surfaces) or planar (e.g., a sketch, image, section, map transect). The representation encodes information primarily in spatial, geometric, or pictorial form, intended to convey meaning through visual structure.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Fold -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Fold">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Specifically_Dependent_Geological_Structure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Shape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Fold_Hinge -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Fold_Hinge">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Specifically_Dependent_Geological_Structure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Fold_Limb -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Fold_Limb">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Specifically_Dependent_Geological_Structure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Generically_Dependent_Continuant -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Generically_Dependent_Continuant">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Continuant"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Generically_Dependant_On"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>GDC: BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000031</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Geological_Law -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Geological_Law">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Norm"/>
        <rdfs:isDefinedBy>A norm that expresses a fundamental, empirically established regularity in geological phenomena, holding universally within the domain of geology.
Examples: Law of Superposition (in sedimentary strata, older layers lie beneath younger ones), Law of Original Horizontality.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Geological_Map_Legend -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Geological_Map_Legend">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Conceptual_Geological_Model"/>
        <rdfs:comment>The legend gives typically temporal and topological relations between objects without specifying shape and locations of the objects</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Geological_Principle -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Geological_Principle">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Norm"/>
        <rdfs:isDefinedBy>A norm that expresses a widely accepted foundational guideline or conceptual rule used in geological reasoning and interpretation. Geological principles may not have the universality of laws but are essential for inference and analysis.
Examples: Principle of Uniformitarianism (“the present is the key to the past”), Principle of Cross-Cutting Relationships.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Geological_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Geological_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Natural_Process"/>
        <rdfs:isDefinedBy>Geological processes are unplanned natural processes that output geological objects, structures, features or qualities of them. These are govenred by geological norms</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Geological_Unit -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Geological_Unit">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Rock_Body"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Geometric_Volumetric_Figure -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Geometric_Volumetric_Figure">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Volumetric_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Geomodel -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Geomodel">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Model"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:Interprets"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:satisfies"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Information_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>A specific subtype of models used to describe geological entities</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Geophysical_Surfacic_Figure -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Geophysical_Surfacic_Figure">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Surfacic_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Geophysical_Volumetric_Figure -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Geophysical_Volumetric_Figure">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Volumetric_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Hybrid -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Hybrid">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Technique"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Hybrid_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Hybrid_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Action_Specification"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:IA -->

    <owl:Class rdf:about="http://www.POKIMON#POK:IA">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Material_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Generic_Dependant"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Information_Content_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Specific_Dependant"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:IQE"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:IQE -->

    <owl:Class rdf:about="http://www.POKIMON#POK:IQE">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Non_Physical_Temporal_Quality"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:concretizes"/>
                        <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Information_Content_Entity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Non_Physical_Temporal_Quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_About"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Specifically_Dependant_On"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:IA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Image -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Image">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Surfacic_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Immaterial_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Immaterial_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Independent_Continuant"/>
        <rdfs:comment>SDC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000141</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Implicit_Modeling -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Implicit_Modeling">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:3D_Structural_Modeling"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Independent_Continuant -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Independent_Continuant">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Continuant"/>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Generically_Dependant_On"/>
                                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Specifically_Dependant_On"/>
                                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                                    </owl:Restriction>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:complementOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>IC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000004</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Information_Content_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Information_Content_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Generically_Dependent_Continuant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_About"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Concretized_By"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:IQE"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Generically_Dependant_On"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:IA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Information_Content_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.POKIMON#POK:Information_Entity"/>
        <rdfs:comment>SDC IAO entity
original uri: http://purl.obolibrary.org/obo/IAO_0000030</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Information_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Information_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Immaterial_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_About"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>An independent continuant that consists of a unit of information, which exists regardless of whether it is currently represented, stored, or communicated. An information entity may have representations, but its existence is not dependent on them.
Examples: the knowledge that water boils at 100 °C at standard pressure, the decision to approve a budget (even if never documented).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Input -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Input">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Role"/>
        <rdfs:isDefinedBy>A role is a realizable entity that inheres in a continuant and is manifested when the continuant participates in a process, specifically as an input to that process</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Input_Selection -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Input_Selection">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Selection_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Instantiating_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Instantiating_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Intelligent_Based -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Intelligent_Based">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Technique"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Inter_Limb_Angle -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Inter_Limb_Angle">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Interpolation_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Interpolation_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Estimation_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Interpretation_Anomaly -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Interpretation_Anomaly">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Interpretaton_Situatiion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Output_Of"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Evaluation_Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A specific situation where some entities are not inconsistent according to a rule, law or any entity that governs these entities</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Interpretation_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Interpretation_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Input"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Situation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Output"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Interpretation_Selection -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Interpretation_Selection">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Selection_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Interpretaton_Situatiion -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Interpretaton_Situatiion">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Situation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                        <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Semantic_Content_Entity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Situation"/>
        <rdfs:isDefinedBy>An Interpretation Situation is an Independent Continuant that is collection of SCEs with their  entities either lacking attributes or deviating from established norms, e.g. some isolated parts of a geological surface that were observed, a fold that is interpreted without location and amplitude, or a normal fault exhibiting reverse displacement.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Interpreted_Origin -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Interpreted_Origin">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Origin"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Knowledge_Modeling -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Knowledge_Modeling">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Modeling_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Kriging -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Kriging">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Algorithm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Lithology -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Lithology">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Logical_Reasoning_Based -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Logical_Reasoning_Based">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Intelligent_Based"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:ML_Based -->

    <owl:Class rdf:about="http://www.POKIMON#POK:ML_Based">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Intelligent_Based"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:ML_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#POK:ML_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Action_Specification"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Map -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Map">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Surfacic_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Material_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Material_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Independent_Continuant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Material_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>SDC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000040</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Model -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Model">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Information_Content_Entity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                        <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Semantic_Content_Entity"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:satisfies"/>
                        <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Information_Entity"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.POKIMON#POK:Depiction_Content_Entity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Information_Content_Entity"/>
        <rdfs:isDefinedBy>an ICE that points to real  entities via the is about relation. Each model has a Semantic Content Entity (SCE) and a Description Content Entity (DCE) as essential parts. The model is internally specifically dependent on the SCE, and internally specifically dependent on the DCE. The dependence is internal because the SCE and DCE are parts of the geomodel (which excludes the model from specifically depending on the SCE in the BFO sense).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Modeling_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Modeling_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Modifying_Entity_Algoirhtm -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Modifying_Entity_Algoirhtm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Algorithm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Modifying_Entity_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Modifying_Entity_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Natural_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Natural_Process">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Unplanned_Process"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Governed_By"/>
                        <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Geological_Law"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Unplanned_Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Governed_By"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Geological_Law"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Natural_Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Governed_By"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Geological_Law"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>Natural processes are non anthropic processes</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Non_Physical_Temporal_Quality -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Non_Physical_Temporal_Quality">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Norm -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Norm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Information_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:governs"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>An information entity that specifies, describes, or prescribes a regularity, principle, or standard — whether arising from natural phenomena, social conventions, or formal regulations — that is used to govern the behaviour of other entities. Norms may be human-created or discovered features of the natural world.
Examples: the law of gravity, Ohm’s law, rules of chess.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Objective_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Objective_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Information_Content_Entity"/>
        <rdfs:comment>IOF entity
original uri :https://spec.industrialontologies.org/ontology/core/Core/ObjectiveSpecification</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Observation_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Observation_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Observed_Origin -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Observed_Origin">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Origin"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Occurrent -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Occurrent">
        <rdfs:comment>SDC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000003</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Origin -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Origin">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Non_Physical_Temporal_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Original_Spatial_Location -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Original_Spatial_Location">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Spatial_Location"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Original_Temporal_Location -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Original_Temporal_Location">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Temporal_Location"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Output -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Output">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Role"/>
        <rdfs:isDefinedBy>A realizable entity that inheres in a continuant and is manifested when the continuant participates in a process, specifically as an output to that process</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Part -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Part">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Role"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Photography -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Photography">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Image"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Physical_Quality -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Physical_Quality">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Physical_Surfacic_Figure -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Physical_Surfacic_Figure">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planar_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Physical_Volumetric_Figure -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Physical_Volumetric_Figure">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Volumetric_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Plan_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Plan_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Information_Content_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Action_Specification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Objective_Specification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>IOF entity
original uri : https://spec.industrialontologies.org/ontology/core/Core/PlanSpecification</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Planar_Figure -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Planar_Figure">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Figurative_Content_Entity"/>
        <rdfs:comment>an ICE about 2D entities</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Planned_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Planned_Process">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Process"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:bearer_Of"/>
                        <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Technique"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Prescribed_By"/>
                        <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Plan_Specification"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:realizes"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Disposition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>IOF entity
original uri : https://spec.industrialontologies.org/ontology/core/Core/PlannedProcess</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Probabilistic -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Probabilistic">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Technique"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Occurrent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>SDC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000015</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Proposition_Content_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Proposition_Content_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Depiction_Content_Entity"/>
        <rdfs:isDefinedBy>A depicition content entity whose representation is realized through a sequence of terms from a language, whether natural or formal, such as those used in textual artifacts (e.g., reports, research papers, map annotations). The representation encodes meaning primarily through syntactic and semantic structures in the chosen language.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Quality -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Quality">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Specifically_Dependent_Continuant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Quality_Of"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>SDC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000019</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:RBF -->

    <owl:Class rdf:about="http://www.POKIMON#POK:RBF">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Algorithm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Random -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Random">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Technique"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Random_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Random_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Action_Specification"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Realizable_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Realizable_Entity">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Specifically_Dependent_Continuant"/>
        <rdfs:comment>SDC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000017</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Reasoning_Based_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Reasoning_Based_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Action_Specification"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Reasoning_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Reasoning_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Reference_Space -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Reference_Space">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Independent_Continuant"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Representation_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Representation_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Input"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Semantic_Content_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Output"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Depiction_Content_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Representational_Quality -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Representational_Quality">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Represented_Geological_Model -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Represented_Geological_Model">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Represented_Model"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:represents"/>
                        <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Geomodel"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Represented_Model"/>
        <rdfs:comment>The spatial dimensions of the represented model should be the same as the abstract model</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Represented_Model -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Represented_Model">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:IQE"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:represents"/>
                        <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Model"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:IQE"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Resolution -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Resolution">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Representational_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Retrieving_Related_Information -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Retrieving_Related_Information">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Rock_Body -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Rock_Body">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Material_Entity"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Rock_Body_Boundary -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Rock_Body_Boundary">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Specifically_Dependent_Geological_Structure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Rock_Material -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Rock_Material">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Material_Entity"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Role -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Role">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Realizable_Entity"/>
        <rdfs:comment>SDC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000023</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Scale -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Scale">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Representational_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Scientific_Geological_Theory -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Scientific_Geological_Theory">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Norm"/>
        <rdfs:isDefinedBy>A norm that constitutes a coherent, empirically supported explanatory framework in geology, integrating multiple laws, principles, and observations to account for a wide range of geological phenomena.
Examples: Plate Tectonic Theory, Continental Drift Theory (historical form), Theory of Seafloor Spreading.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Seismic_Profile -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Seismic_Profile">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Geophysical_Surfacic_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Selection -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Selection">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Continuant_Aggregate"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Selection_Algorithm -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Selection_Algorithm">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Algorithm"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Selection_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Selection_Process">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Output"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Selection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Semantic_Content_Entity -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Semantic_Content_Entity">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Information_Content_Entity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Semantic_Component"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Information_Content_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Origin"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Origin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Quality"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Quality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Output_Of"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Planned_Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Part_Of"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>is output of information generation process</rdfs:comment>
        <rdfs:isDefinedBy>An information content entity that represents the abstract semantic part of a model—what the model is about in reality. Like any ICE an SCE is about a portion of reality; the one that the model is about. The SCE captures the model’s meaning formally  within a given domain ontology, making it copiable and transferable without loss of semantic content. The SCE is related to the modeled entity via has_Semantic_Component relation. An SCE can be realized in multiple depiction content entities (DCEs) without changing its meaning—independent of any particular depiction paradigm.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Shape -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Shape">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Specifically_Dependant_On"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Independent_Continuant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Situation -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Situation">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Independent_Continuant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Some portion of reality including possible, real, imaginary and impossible objects</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Situation_Selection -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Situation_Selection">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Selection_Process"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Size -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Size">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Sketch -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Sketch">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Image"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Space_Time_Geological_Model -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Space_Time_Geological_Model">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Geomodel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:satisfies"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Conceptual_Geological_Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:substitutes"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Space_Time_Geological_Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A model about some geological entities located precisly both in space and time</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Spatial_Dimension -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Spatial_Dimension">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Spatial_Location -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Spatial_Location">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Spatial_Region -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Spatial_Region">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Immaterial_Entity"/>
        <rdfs:comment>SDC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000006</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Spatial_Space -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Spatial_Space">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Reference_Space"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Dimension"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.POKIMON#POK:Spatial_Dimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.POKIMON#POK:Temporal_Space"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Spatio_Temporal_Space -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Spatio_Temporal_Space">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Reference_Space"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Specifically_Dependent_Continuant -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Specifically_Dependent_Continuant">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Continuant"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Specifically_Dependant_On"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>SDC BFO entity
original uri: http://purl.obolibrary.org/obo/BFO_0000020</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Specifically_Dependent_Geological_Structure -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Specifically_Dependent_Geological_Structure">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Specifically_Dependent_Continuant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Specifically_Dependant_On"/>
                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:Rock_Body"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>A temporarily mapping of the class geological structures from GSO (original GSO uri https://w3id.org/gso/1.0/geology/Geologic_Structure). It considers contacts, faults, and folds as geologic structures</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Stratigraphic_Column -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Stratigraphic_Column">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Conceptual_Geological_Model"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Strike -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Strike">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Technique -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Technique">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Non_Physical_Temporal_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Temporal_Location -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Temporal_Location">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Temporal_Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Temporal_Quality -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Temporal_Quality">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Quality"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Temporal_Space -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Temporal_Space">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Reference_Space"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Transect -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Transect">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Physical_Surfacic_Figure"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:Unplanned_Process -->

    <owl:Class rdf:about="http://www.POKIMON#POK:Unplanned_Process">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.POKIMON#POK:Process"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.POKIMON#POK:is_Governed_By"/>
                        <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Norm"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Process"/>
        <rdfs:isDefinedBy>Unplanned processes are not prescribed by a plan specification but instead are governed by norms</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:User_Based -->

    <owl:Class rdf:about="http://www.POKIMON#POK:User_Based">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Technique"/>
    </owl:Class>
    


    <!-- http://www.POKIMON#POK:User_Based_Specification -->

    <owl:Class rdf:about="http://www.POKIMON#POK:User_Based_Specification">
        <rdfs:subClassOf rdf:resource="http://www.POKIMON#POK:Action_Specification"/>
