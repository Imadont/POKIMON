                <owl:someValuesFrom rdf:resource="http://www.POKIMON#POK:IA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.POKIMON#POK:has_Part"/>
                <owl:allValuesFrom rdf:resource="http://www.POKIMON#POK:Information_Content_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.POKIMON#POK:Information_Entity"/>
