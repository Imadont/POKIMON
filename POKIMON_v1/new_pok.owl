<owl:Class rdf:about="#POK:IQE">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#POK:Non_Physical_Temporal_Quality"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#POK:concretizes"/>
          <owl:someValuesFrom rdf:resource="#POK:Information_Content_Entity"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#POK:Non_Physical_Temporal_Quality"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#POK:is_About"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#POK:is_Specifically_Dependant_On"/>
      <owl:someValuesFrom rdf:resource="#POK:IA"/>
    </owl:Restriction>
  </rdfs:subClassOf>
